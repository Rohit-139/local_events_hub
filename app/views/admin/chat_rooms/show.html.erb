<%= render "admin/header" %>

<%= turbo_stream_from @chat_room %>
<div class="flex flex-col w-96 mt-4 mx-auto h-screen max-h-screen p-4 bg-gray-600">
  <!-- Header -->
  <div class="pb-4 border-b bg-blue-500 border-gray-300">
    <h2 align="center" class="text-xl text-gray-100 font-bold">Chat </h2>
  </div>

  <div id="messages" class="flex-1 overflow-y-auto p-4 space-y-4">
    <%# render @messages %>
    <%= render partial: 'admin/messages/message', collection: @messages %> 

  </div>


  <%= form_with(model: @message, 
              url: admin_messages_path, 
              method: :post, 
              data: { controller: "form-reset", action: "turbo:submit-end->form-reset#reset" }) do |f| %>
    <div class="flex gap-2">
        <%= f.hidden_field :chat_room_id, value: @chat_room.id %>

      <%= f.text_field :body, class: "flex-1 p-2 border rounded-lg", placeholder: "Type a message..." %>
      <%= f.submit "Send", class: "bg-blue-500 text-white px-4 py-2 rounded-lg" %>
    </div>
  <% end %>
</div>
  









 




