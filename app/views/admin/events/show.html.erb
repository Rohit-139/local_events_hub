<%= render 'admin/header' %>

<div  class="block w-96 mx-auto rounded-lg p-4 shadow-xs shadow-indigo-100 mt-6">
	<% if @event.image.attached? %>
	 <%= image_tag @event.image.representation(resize_to_limit:[600,600]) ,class:"h-56 w-full rounded-md object-cover" %>	
	<% end %>

	<div class="mt-2">
		<dl>
			<div>
			 <dt class="sr-only">Name</dt>
        <dd class="text-lg text-gray-100"><%=@event.name%></dd>
			</div>


			<div>
        <dt class="sr-only">Description</dt>
        <dd class="font-medium text-sm text-gray-300"><%= @event.description %></dd>
      </div>
		</dl>


		<div class="mt-6 flex items-center gap-18 text-xs">
      <div class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
       
        <div class="mt-1.5 sm:mt-0">
          <p class="text-gray-200">Ticket Price</p>

          <p class="font-medium text-gray-100"><%= @event.ticket_price %></p>
        </div>
      </div>



      <div class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
        <div class="mt-1.5 sm:mt-0">
          <p class="text-gray-200">Total seats</p>

          <p class="font-medium text-gray-100"><%= @event.total_seat %></p>
        </div>
      </div>
		
       <div class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
        <div class="mt-1.5 sm:mt-0">
          <p class="text-gray-200">Available seats</p>

          <p class="font-medium text-gray-100"><%= @event.available_seat %></p>
        </div>
      </div>

	</div>

	<div class="mt-4 text-bold text-gray-300">Address: <%= @event.address %></div>
</div>
</div>



</div>

 <div class="space-y-6  mt-4">
   <button type="submit" class="flex w-96 mx-auto justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"><%= link_to "Edit Event", edit_admin_event_path %></button> 
  </div>


