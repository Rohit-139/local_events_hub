<div style="display: flex; gap: 500px;">
	<h1 style="margin-left: 50px;">All Events </h1>
	<h3><%= button_to "Logout", destroy_user_session_path, method: :delete %></h3>
</div>

<div>
	<% if @events.present? %>
	<table border="2px" cellpadding="10px">
		<tr>
		<th>Name</th>
		<th>total_seat</th>
		<th>ticket</th>
		<th>Action</th>
		<th>Action</th>
		<th>Action</th>
		</tr>
			<% @events.each do |event| %>
			<tr id="<%= dom_id(event) %>">
			<td><%= event.name%></td>
			<td><%= event.total_seat%></td>
			<td><%= event.ticket_price%></td>
			<td> <%= link_to "Edit", edit_admin_event_path(event)%></td>
			<td> <%= link_to "Show", admin_event_path(event)%></td>
			<td> <%= link_to "Delete",admin_event_path(event), data: {turbo_method: :delete, turbo_confirm: 'are you sure ?'}%></td>
			</tr>
			<% end %>
	</table>
	<%= link_to "Create new Event", new_admin_event_path %>
	<% else %>
	<h3>There is no events listed yet</h3>
	<%= link_to "Create new Event", new_admin_event_path %>
	<% end %>
</div>

