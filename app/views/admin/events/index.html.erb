<%= render "admin/header" %>

<div class="max-h-100 overflow-x-auto mt-2">
	<% if @events.present? %>
	<table class="min-w-full divide-y-2  dark:divide-gray-700">
		<thead class="sticky top-0  ltr:text-left rtl:text-right dark:bg-gray-900">
		<tr class="*:font-medium *:text-gray-900 dark:*:text-white">
		<th class="px-3 py-2 whitespace-nowrap">Name</th>
		<th class="px-3 py-2 whitespace-nowrap">total seat</th>
		<th class="px-3 py-2 whitespace-nowrap">ticket</th>
		<th class="px-3 py-2 whitespace-nowrap">Action</th>
		<th class="px-3 py-2 whitespace-nowrap">Action</th>
		<th class="px-3 py-2 whitespace-nowrap">Action</th>
		<th class="px-3 py-2 whitespace-nowrap">Bookings</th>
		</tr>
	</thead>
			<% @events.each do |event| %>
			<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
		    <tr class="*:text-gray-900 *:first:font-medium dark:*:text-white" id="<%= dom_id(event)%>">

			<td  class="px-3 py-2 whitespace-nowrap"><%= event.name%></td>
			<td  class="px-3 py-2 whitespace-nowrap"><%= event.total_seat%></td>
			<td  class="px-3 py-2 whitespace-nowrap"><%= event.ticket_price%></td>
			<td  class="px-5 py-2 whitespace-nowrap bg-yellow-700 rounded"> <%= link_to "Edit", edit_admin_event_path(event)%></td>
			<td  class="px-5 py-2 whitespace-nowrap bg-green-700 rounded"> <%= link_to "Show", admin_event_path(event)%></td>
			<td  class="px-5 py-2 whitespace-nowrap bg-red-700"> <%= link_to "Delete",admin_event_path(event), data: {turbo_method: :delete, turbo_confirm: 'are you sure ?'}%></td>
			<td  class="px-5 py-2 whitespace-nowrap bg-gray-600 "> <%= link_to "Bookings", admin_index_path(event)%></td>

			</tr>
		</tbody>
			<% end %>
	</table>
	<% else %>
	<div class="min-w-full bg-gray-300 h-96">
		<h2 align="center" class="text-3xl font-bold mt-4 p-4">There is no events listed yet </h2>
	<div class="m-4 py-4">
    <button  type ="submit" class="flex w-96 mx-auto justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"><%= link_to "Create new Event", new_admin_event_path %> </button>
  </div>
	
	<% end %></div>
</div>

