<%= form_with(model:[:admin, event] ) do |form| %>
  <% if event.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>

      <ul>
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
  	<%= form.label :name, style: "display: block" %>
  	<%= form.text_field :name, required: true %>
  </div>

  <br>

    <div>
  	<%= form.label :description, style: "display: block" %>
  	<%= form.text_field :description , required: true %>
  </div>

  <br>

    <div>
  	<%= form.label :total_seat, style: "display: block" %>
  	<%= form.number_field :total_seat , required: true  %>
  </div>

<br>
    <div>
  	<%= form.label :ticket_price, style: "display: block" %>
  	<%= form.number_field :ticket_price , required: true  %>
  </div>

<br>
    <div>
  	<%= form.label :street, style: "display: block" %>
  	<%= form.text_field :street , required: true  %>
  </div>

  <br>

    <div>
  	<%= form.label :city, style: "display: block" %>
  	<%= form.text_field :city , required: true  %>
  </div>


<br>
    <div>
  	<%= form.label :state, style: "display: block" %>
  	<%= form.text_field :state , required: true  %>
  </div>


<br>
    <div>
    	<div>
  	<%= form.label :image, style: "display: block" %>
  	<% if event.image.attached? %>
  	<%= image_tag event.image.representation(resize_to_limit: [200,200])%>
  	<p>want to change image ?</p>
  	<%= form.file_field :image %>
  	<% else %>
  	<%= form.file_field :image, required: true %>
  	<% end %>
  	</div>
  	
  	
  </div>



<br>
  <div>
  	<%= form.submit %>
  </div>

  <%end %>